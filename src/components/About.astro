---
import { t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<section class="content" id="om">
  <div class="wrap">
    <div class="eyebrow">{t(lang, 'about_eyebrow')}</div>
    <h2>{t(lang, 'about_h2')}</h2>
    <p>{t(lang, 'about_p')}</p>
    <div class="timeline">
      <div class="tl"><div class="year">2019</div><p>{t(lang, 'tl_2019')}</p></div>
      <div class="tl"><div class="year">2023</div><p>{t(lang, 'tl_2023')}</p></div>
      <div class="tl"><div class="year">2026</div><p>{t(lang, 'tl_2026')}</p></div>
      <div class="tl future"><div class="year">2027</div><p>{t(lang, 'tl_2027')}</p></div>
    </div>
  </div>
</section>
