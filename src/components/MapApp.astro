---
import { t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<div id="mapApp" data-lang={lang} class="map-exhibit-frame">
  <div class="wrap">
    <div class="map-card">
      <div class="map-card-label">{t(lang, 'map_eyebrow')}</div>

      <div class="stat-strip">
        <div class="stat-band" id="statBand"></div>
      </div>

      <div class="map-section">
        <div id="map"></div>
        <div class="port-panel" id="portPanel"></div>
      </div>
    </div>
  </div>
</div>

<script>
  import { initMapApp } from '../lib/map-app';

  const root = document.getElementById('mapApp');
  if (root) initMapApp(root);
</script>
